# ==========================================
# GitIgnore para Projeto Python / Flask
# Aluno: Gustavo Mota
# ==========================================

# Ambientes Virtuais (Virtual Environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / arquivos otimizados do Python
__pycache__/
*.py[cod]
*$py.class

# Distribuição e empacotamento
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Arquivos de log
*.log
pip-log.txt
pip-delete-this-directory.txt

# Arquivos de teste e cobertura (Coverage / PyTest)
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Variáveis de ambiente e segredos locais
.env
.env.*
.venv*
*.local

# Configurações de IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Arquivos temporários do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Scripts de automação local
*.bat
*.ps1
